// Serveur de parties multijoueur : un Durable Object par partie.
{
  "name": "voxelcraft-multi",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // Stockage SQLite : le seul disponible sur l'offre gratuite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Pages autorisées à se connecter (le jeu publié, et le développement local).
    "ALLOWED_ORIGINS": "https://corrreon.github.io,http://localhost:5173,http://localhost:4173"
  }
}
